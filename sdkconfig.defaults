CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# LVGL settings from Waveshare's 02_lvgl_demo_v9 for this board and the esp_lvgl_adapter
# README: C-library malloc (the 64 KB built-in pool is too small for the analog face),
# FreeRTOS OS layer, style cache. One software draw unit: parallel draw units were
# ruled out after display corruption in v0.4.0.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Dark default theme for the settings keyboard and text field.
CONFIG_LV_THEME_DEFAULT_DARK=y
# LVGL warnings and asserts go to the serial console instead of hanging silently.
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
# No 32 kHz crystal on the 1.75C (GPIO15 is I2C SDA). The divided internal 17.5 MHz
# oscillator is more stable than the default 136 kHz RC for timekeeping in sleep
# (ESP-IDF system_time docs), at about 5 uA more sleep current.
CONFIG_RTC_CLK_SRC_INT_8MD256=y
# A firmware hang (task watchdog: a CPU's idle task starved for 5 s) panics and reboots
# instead of leaving a frozen or black screen.
CONFIG_ESP_TASK_WDT_PANIC=y
# Keep internal RAM free for the SPI driver's DMA bounce buffers: the board package streams the
# PSRAM draw buffers through internal-RAM copies (~46 KB per strip). Wi-Fi/lwIP buffers go to PSRAM
# and general mallocs fall back to PSRAM once internal free RAM drops below 128 KB.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
